# Copy this file to .env.local and fill in values from your Supabase project
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical site URL — used for OG tags, canonical <link>, and robots host.
# Leave empty for local dev (defaults to http://localhost:3000).
# On Vercel, set this to your production domain (e.g. https://profiler.example).
NEXT_PUBLIC_SITE_URL=
