# Copy this file to .env.local and fill in values from your Supabase project
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — server-only, NEVER prefix with NEXT_PUBLIC_.
# Used for privileged operations (e.g. deleting an auth user).
# Found at: Supabase → Project Settings → API → "service_role" key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical site URL — used for OG tags, canonical <link>, and robots host.
# Leave empty for local dev (defaults to http://localhost:3000).
# On Vercel, set this to your production domain (e.g. https://profiler.example).
NEXT_PUBLIC_SITE_URL=
